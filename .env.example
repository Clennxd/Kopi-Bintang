# Kredensial Supabase (ambil dari Dashboard > Project Settings > API)
# Biarkan kosong untuk menjalankan aplikasi dalam mode demo dengan data lokal (/images/...).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Nomor WhatsApp tujuan pemesanan (format internasional tanpa tanda +)
VITE_WHATSAPP_NUMBER=6281234567890

# Nama toko yang ditampilkan pada header pesan WhatsApp
VITE_STORE_NAME=Kopi Bintang
